{
  "name": "obolargus-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Financial application UI built on lx_client",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:docs-runner": "webpack --config webpack.docs-runner.config.js --mode production",
    "test": "jest",
    "lint": "./node_modules/.bin/eslint js --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:sw": "tsc -p tsconfig.sw.json --noEmit",
    "serve:prod": "serve -s . -l 8081 -c serve.json",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "subset:icons": "node scripts/subset-icons.mjs",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "js-yaml": "^5.5.0",
    "lx_client": "file:../lx_client",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "workbox-window": "7.4.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@storybook/react-webpack5": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.memoize": "^4.1.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "^30.5.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.14.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "serve": "^14.2.7",
    "style-loader": "^4.0.0",
    "subset-font": "^2.9.0",
    "svg-inline-loader": "^0.8.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "whatwg-fetch": "^3.6.20",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-webpack-plugin": "7.4.1"
  },
  "jest": {
    "transform": {
      "^.+\\.(ts|tsx|js|jsx|mjs)$": "<rootDir>/../lx_client/jest.transformer.js"
    },
    "testEnvironment": "jsdom",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "<rootDir>/js/jest.setup.ts"
    ],
    "testMatch": [
      "**/js/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [],
    "moduleNameMapper": {
      "^react$": "<rootDir>/../lx_client/node_modules/react",
      "^react/jsx-runtime$": "<rootDir>/../lx_client/node_modules/react/jsx-runtime",
      "^react/jsx-dev-runtime$": "<rootDir>/../lx_client/node_modules/react/jsx-dev-runtime",
      "^react-dom$": "<rootDir>/../lx_client/node_modules/react-dom",
      "^react-dom/(.*)$": "<rootDir>/../lx_client/node_modules/react-dom/$1",
      "^react-router-dom$": "<rootDir>/../lx_client/node_modules/react-router-dom",
      "^tslog$": "<rootDir>/js/__mocks__/tslog.ts",
      "^lx_client/(.*)$": "<rootDir>/../lx_client/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "^d3$": "<rootDir>/../lx_client/node_modules/.pnpm/d3@7.9.2/node_modules/d3/dist/d3.min.js"
    },
    "coverageThreshold": {
      "global": {
        "lines": 90
      }
    }
  }
}
